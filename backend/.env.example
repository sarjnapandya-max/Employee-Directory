PORT=5000
MONGO_URI=
JWT_SECRET=
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Authentication Mode
# Use "local" during development.
# GSPL IT can change this to "ldap" during LDAP deployment.
AUTH_MODE=local


# LDAP / Active Directory Configuration
# These values must be provided/configured by GSPL IT.
# Do NOT put real passwords or secrets in this file.

LDAP_URL=
LDAP_PORT=389

# Base DN of the GSPL LDAP / Active Directory domain.
# Example format only:
# LDAP_BASE_DN=DC=example,DC=com
LDAP_BASE_DN=

# Service account used by the application
# to search for employee/user accounts.
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=

# Optional: specific location where user accounts are searched.
# If this is empty, the application will use LDAP_BASE_DN.
# Example format only:
# LDAP_USER_SEARCH_BASE=OU=Users,DC=example,DC=com
LDAP_USER_SEARCH_BASE=

# LDAP filter used to find the user.
# GSPL IT should confirm the correct attribute/filter.
# Example only:
# LDAP_USER_SEARCH_FILTER=(sAMAccountName={username})
LDAP_USER_SEARCH_FILTER=